# Optional server-only URL for deferred backend-backed surfaces.
# Frontend demo authentication and the public catalog do not require it.
# If configured, use an HTTPS public origin on Vercel, never a private/container-only hostname.
ZAPSTERS_API_URL=http://127.0.0.1:8000

# Keep demo auth for local/Vercel frontend-only usage. Set to backend only when FastAPI is deployed.
NEXT_PUBLIC_AUTH_MODE=demo

# Public canonical URL used for metadata. Optional locally; set to the production hostname.
NEXT_PUBLIC_SITE_URL=https://academy-zap.vercel.app

# Optional deferred-surface demo controls. Keep disabled for production.
NEXT_PUBLIC_DEMO_MODE=false
