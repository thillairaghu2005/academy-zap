# App
ENV=development
SECRET_KEY=change-me-to-a-random-32-byte-value-minimum

# Database / cache
# Host ports 5433/6380, not the 5432/6379 defaults — see docker-compose.yml's comments (this
# machine may already run another project's Postgres/Redis on the standard ports).
DATABASE_URL=postgresql+asyncpg://zapsters:zapsters@localhost:5433/zapsters
REDIS_URL=redis://localhost:6380/0

# JWT
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_SECONDS=900
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Object storage (MinIO, local dev)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=zapsters
S3_SECRET_KEY=zapsters-secret
S3_BUCKET=zapsters-dev

# Search
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_API_KEY=zapsters-dev-master-key

# Judge Engine (Slice 10)
# Sandbox adapter: `gvisor` (Kubernetes, PRODUCTION) or `docker` (DevelopmentOnly, NEVER
# selectable in production — Settings construction fails closed with ENV=production).
JUDGE_SANDBOX_TYPE=gvisor
# Digest-pinned Python image for the sandbox (floating tags are never acceptable in prod).
JUDGE_SANDBOX_IMAGE=python:3.12-alpine@sha256:d09d15e60962ca365d1cd544a48773bac9d33f2fb1b00f2aa0deec78ade7dc31
# Kubernetes sandbox target (runtimeClass=gvisor must exist in the cluster).
JUDGE_SANDBOX_NAMESPACE=judge-sandboxes
JUDGE_SANDBOX_RUNTIME_CLASS=gvisor
# Per-submission resource caps (enforced during execution, not post-hoc).
JUDGE_SANDBOX_MAX_OUTPUT_BYTES=65536
JUDGE_SANDBOX_MAX_PROCESSES=64
JUDGE_SANDBOX_MAX_DISK_MB=64
JUDGE_SANDBOX_CPU_LIMIT=1
JUDGE_SANDBOX_MEMORY_LIMIT_MB=256
JUDGE_SANDBOX_WALL_GRACE_SECONDS=5
# Worker reliability (F-10): reclaim idle pending messages after this idle window; retry cap
# before a submission is failed and moved to the judge dead-letter stream.
JUDGE_RECLAIM_IDLE_MS=60000
JUDGE_MAX_RETRIES=3
JUDGE_WORKER_CONSUMER_NAME=judge-worker
