# App
ENV=development
SECRET_KEY=change-me-to-a-random-32-byte-value-minimum

# Database / cache
# Host ports 5433/6380, not the 5432/6379 defaults — see docker-compose.yml's comments (this
# machine may already run another project's Postgres/Redis on the standard ports).
DATABASE_URL=postgresql+asyncpg://zapsters:zapsters@localhost:5433/zapsters
REDIS_URL=redis://localhost:6380/0

# JWT
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_SECONDS=900
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Object storage (MinIO, local dev)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=zapsters
S3_SECRET_KEY=zapsters-secret
S3_BUCKET=zapsters-dev

# Search
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_API_KEY=zapsters-dev-master-key
